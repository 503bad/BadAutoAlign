{
  "name": "bad-auto-align",
  "productName": "BadAutoAlign",
  "version": "0.2.0",
  "description": "MIDI/WAVガイドによるボーカルのタイミング・ピッチ一括補正（スタンドアローン版）",
  "author": {
    "name": "Igarashi Date"
  },
  "company": "503 bad gateway",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.badgateway503.badautoalign",
    "productName": "BadAutoAlign",
    "copyright": "© 2026 Igarashi Date / 503 bad gateway",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../dist/vat-serve",
        "to": "vat-serve"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
