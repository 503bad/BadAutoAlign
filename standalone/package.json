{
  "name": "bad-auto-align",
  "productName": "BadAutoAlign",
  "version": "0.5.1",
  "description": "MIDI/WAVガイドによるボーカルのタイミング・ピッチ一括補正（スタンドアローン版）",
  "author": {
    "name": "503 bad gateway"
  },
  "main": "main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:trial": "electron . --edition=trial",
    "dist": "node scripts/dist.js all",
    "dist:full": "node scripts/dist.js full",
    "dist:trial": "node scripts/dist.js trial"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.badgateway503.badautoalign",
    "productName": "BadAutoAlign",
    "copyright": "© 2026 503 bad gateway",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/vat-serve",
        "to": "vat-serve"
      },
      {
        "from": "../EULA.txt",
        "to": "EULA.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "../EULA.txt"
    }
  },
  "private": true
}
